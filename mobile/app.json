{
  "expo": {
    "name": "YouAreTheHero",
    "slug": "YouAreTheHero",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "youarethehero",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "You Are The Hero utilise l'appareil photo pour illustrer les histoires et prendre le selfie du héros.",
          "photosPermission": "You Are The Hero accède à ta galerie pour illustrer les histoires."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "You Are The Hero utilise la caméra frontale pour prendre le selfie de ton héros."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3EBDB"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
